# Backend API & WebSocket Server URL (e.g. Render, Railway, VPS, or custom domain)
# Example: https://skillconnect-api.onrender.com
VITE_BACKEND_URL=
# Alternatively, specify the full API endpoint (defaults to VITE_BACKEND_URL/api):
# VITE_API_URL=https://skillconnect-api.onrender.com/api

# EmailJS Configuration (Get credentials at https://dashboard.emailjs.com/)
VITE_EMAILJS_SERVICE_ID=service_skillconnect
VITE_EMAILJS_TEMPLATE_ID=template_booking_notify
VITE_EMAILJS_PUBLIC_KEY=your_public_key_here
